#!/usr/bin/env bash

set -euo pipefail

repositoryRoot="$(git rev-parse --show-toplevel)"
cd "${repositoryRoot}"

files=()
while IFS= read -r -d '' file
do
    files+=("${file}")
done < <(git diff --cached --name-only --diff-filter=ACMR -z -- '*.cpp' '*.h')

if (( ${#files[@]} == 0 )); then
    exit 0
fi

clangFormat="${CLANG_FORMAT_BIN:-clang-format}"
if ! command -v "${clangFormat}" >/dev/null 2>&1; then
    if [[ -z "${CLANG_FORMAT_BIN:-}" ]] && command -v xcrun >/dev/null 2>&1
    then
        clangFormat="$(xcrun --find clang-format 2>/dev/null || true)"
    fi

    if [[ -z "${clangFormat}" ]] || [[ ! -x "${clangFormat}" ]]
    then
        echo "pre-commit: clang-format was not found. Add it to PATH or set CLANG_FORMAT_BIN." >&2
        exit 1
    fi
fi

for file in "${files[@]}"
do
    if ! git diff --quiet -- "${file}"; then
        echo "pre-commit: ${file} has unstaged changes; stage or stash them before committing." >&2
        exit 1
    fi
done

"${clangFormat}" --style="file:${repositoryRoot}/.clang-format" -i -- "${files[@]}"
git add -- "${files[@]}"
